{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    ":dependencyDashboard",
    "schedule:weekly"
  ],
  "enabledManagers": [
    "custom.regex",
    "npm",
    "github-actions"
  ],
  "minimumReleaseAge": "1 day",
  "internalChecksFilter": "strict",
  "ignorePaths": [
    "**/node_modules/**"
  ],
  "automerge": false,
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "labels": [
    "dependencies"
  ],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": [
      "dependencies",
      "security"
    ]
  },
  "lockFileMaintenance": {
    "enabled": true
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Speakeasy mirror (same as continuous)",
      "managerFilePatterns": [
        "/^\\.speakeasy/workflow\\.yaml$/"
      ],
      "matchStrings": [
        "speakeasyVersion: (?<currentValue>\\S+)"
      ],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "speakeasy-api/speakeasy",
      "extractVersionTemplate": "^v(?<version>.*)$"
    }
  ],
  "packageRules": [
    {
      "description": "Speakeasy generates package.json and examples/package.json, so updates change only the package-lock.json files while the new version is within the declared range.",
      "matchManagers": [
        "npm"
      ],
      "rangeStrategy": "update-lockfile"
    },
    {
      "description": "Speakeasy pins the dev toolchain (devDependencies) and declares peerDependencies, and a major update falls outside the declared caret range, so these regular updates would edit package.json and be reverted; the final rule keeps security updates.",
      "matchManagers": [
        "npm"
      ],
      "matchDepTypes": [
        "devDependencies",
        "peerDependencies"
      ],
      "matchUpdateTypes": [
        "*"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "As in continuous: manifests' toolchain and runtime constraints, workflow runners, package overrides and Go replace directives keep their hand-set versions.",
      "matchUpdateTypes": [
        "*"
      ],
      "matchDepTypes": [
        "golang",
        "toolchain",
        "packageManager",
        "engines",
        "requires-python",
        "required_version",
        "github-runner",
        "service",
        "install",
        "overrides",
        "replace"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "sdk-minor-patch"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "actions-minor-patch"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "tool pins"
    },
    {
      "matchManagers": [
        "custom.regex"
      ],
      "addLabels": [
        "tool-pins"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "prBodyNotes": [
        "`package.json` is generator-owned: Speakeasy rewrites it on every regeneration. If this PR changes `package.json`, add the same floor to `.speakeasy/gen.yaml` under `typescript.additionalDependencies.dependencies (or .devDependencies)` in this PR, or the next regeneration reverts it. A change to the lock file only survives regeneration."
      ]
    },
    {
      "description": "As in continuous: a rule above that matches every update type disables dependencies only after lookup, when Renovate knows which updates fix a vulnerability, so this rule keeps their security updates.",
      "matchJsonata": [
        "isVulnerabilityAlert"
      ],
      "enabled": true
    }
  ]
}
